# Copy this file to .env and fill in real values.
# Never commit the real .env file — add it to .gitignore.

# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# At least one AI provider key is required for the AI chat feature to work.
GROQ_API_KEY=
GEMINI_API_KEY=

# Token that protects the /api/* dashboard endpoints (required).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=

# Optional: Telegram chat ID that gets notified when a patient confirms an
# appointment (e.g. a staff member's chat with the bot, or a private group
# the bot has been added to). Leave blank to disable notifications.
ADMIN_CHAT_ID=

# Optional overrides
PORT=8080
DB_PATH=mediassistant.db
CONFIG_FILE=config.json
PROFILE_FILE=clinic_profile.txt
